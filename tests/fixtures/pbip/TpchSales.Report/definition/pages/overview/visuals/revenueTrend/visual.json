{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "revenueTrend",
  "position": { "x": 20, "y": 160, "z": 1000, "width": 900, "height": 400 },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": { "SourceRef": { "Entity": "Date" } },
                  "Property": "Month"
                }
              },
              "queryRef": "Date.Month",
              "nativeQueryRef": "Month",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "orders" } },
                  "Property": "Revenue"
                }
              },
              "queryRef": "orders.Revenue",
              "nativeQueryRef": "Revenue"
            },
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "orders" } },
                  "Property": "Revenue LY"
                }
              },
              "queryRef": "orders.Revenue LY",
              "nativeQueryRef": "Revenue LY",
              "displayName": "Last year"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": { "Column": { "Expression": { "SourceRef": { "Entity": "Date" } }, "Property": "Month" } },
            "direction": "Ascending"
          }
        ],
        "isDefaultSort": true
      }
    },
    "visualContainerObjects": {
      "title": [
        { "properties": { "text": { "expr": { "Literal": { "Value": "'Revenue by month'" } } } } }
      ]
    }
  }
}
