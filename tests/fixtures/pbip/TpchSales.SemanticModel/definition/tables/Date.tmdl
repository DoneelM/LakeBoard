/// Calendar table built inside the model (calendar year; no fiscal calendar).
table Date
	lineageTag: 6c2a0b11-0000-4000-8000-000000000006
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Long Date
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	column Year = YEAR('Date'[Date])
		dataType: int64
		formatString: 0
		summarizeBy: none

	column Month = FORMAT('Date'[Date], "yyyy-MM")
		dataType: string
		summarizeBy: none

	partition Date = calculated
		mode: import
		source = CALENDAR(DATE(1992, 1, 1), DATE(1998, 12, 31))

