{
  "text": "<!doctype html>\n<meta name=\"dash-one-writer\" content=\"true\">\n<style>\n  :root { --bk-accent: var(--color-ok); }\n  .bk-grid { display: grid; gap: var(--cds-gap-md); color: var(--color-fg); }\n  .bk-note { color: var(--cds-text-tertiary); border-radius: var(--cds-radius); }\n  .bk-kpi { border-left: 3px solid var(--bk-accent); }\n</style>\n<h1>Bakehouse sales by country</h1>\n<div class=\"bk-grid\">\n  <div class=\"bk-kpi\" data-draw=\"kpis\"></div>\n  <div data-draw=\"daily\"></div>\n  <div data-draw=\"reviews\"></div>\n  <p class=\"bk-note\">Targets: <span id=\"bk-target\"></span></p>\n  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"0\" height=\"0\"></svg>\n</div>\n<script src=\"charts.js\"></script>\n<script>\ndash.calc('total', { inputs: ['sales'], fn: (rows) => [{ revenue: rows.reduce((s, r) => s + Number(r.revenue || 0), 0) }] });\ndash.draw('kpis', el => { const t = dash.data('total'); el.textContent = t.status === 'ok' ? 'Revenue ' + t.data[0].revenue : ''; });\ndash.draw('daily', el => bkLine(el, dash.data('sales').data || []));\ndash.draw('reviews', el => bkBars(el, dash.data('reviews').data || []));\ndash.onData(() => { document.getElementById('bk-target').textContent = (dash.data('targets').data || []).length + ' targets'; });\n</script>\n"
}
